      "Bash(scripts/dc.sh core/ntfy* up*)",
      "Bash(scripts/dc.sh core/traefik* up*)",
      "Bash(scripts/dc.sh core/uptime-kuma* up*)",
      "Bash(scripts/dc.sh media/* up*)",
      "Bash(scripts/dc.sh tools/* up*)",
      "Bash(scripts/dc.sh ./* up*)",
      "Bash(scripts/dc.sh core/adguard* down*)",
      "Bash(scripts/dc.sh core/docker-socket-proxy* down*)",
      "Bash(scripts/dc.sh core/ntfy* down*)",
      "Bash(scripts/dc.sh core/traefik* down*)",
      "Bash(scripts/dc.sh core/uptime-kuma* down*)",
      "Bash(scripts/dc.sh media/* down*)",
      "Bash(scripts/dc.sh tools/* down*)",
      "Bash(scripts/dc.sh ./* down*)",
      "Bash(scripts/dc.sh core/adguard* stop*)",
      "Bash(scripts/dc.sh core/docker-socket-proxy* stop*)",
      "Bash(scripts/dc.sh core/ntfy* stop*)",
      "Bash(scripts/dc.sh core/traefik* stop*)",
      "Bash(scripts/dc.sh core/uptime-kuma* stop*)",
      "Bash(scripts/dc.sh media/* stop*)",
      "Bash(scripts/dc.sh tools/* stop*)",
      "Bash(scripts/dc.sh ./* stop*)",
      "Bash(scripts/dc.sh core/adguard* restart*)",
      "Bash(scripts/dc.sh core/docker-socket-proxy* restart*)",
      "Bash(scripts/dc.sh core/ntfy* restart*)",
      "Bash(scripts/dc.sh core/traefik* restart*)",
      "Bash(scripts/dc.sh core/uptime-kuma* restart*)",
      "Bash(scripts/dc.sh media/* restart*)",
      "Bash(scripts/dc.sh tools/* restart*)",
      "Bash(scripts/dc.sh ./* restart*)",
      "Bash(scripts/dc.sh core/dashboard down*)",
      "Bash(scripts/dc.sh core/dashboard stop*)",
      "Bash(docker compose * up *)",
      "Bash(docker compose * down *)",
      "Bash(curl * -d *)",
      "Bash(curl * --data*)",
      "Bash(curl * -X *)",
      "Edit(./scripts/backup.sh)",
      "Edit(./scripts/backup-excludes.txt)",
      "Edit(./systemd/**)",
      "Edit(./bootstrap.sh)",
      "Edit(./.claude/**)",
      "Bash(scripts/dc.sh core/ha-backups* up*)",
      "Bash(scripts/dc.sh core/ha-backups* down*)",
      "Bash(scripts/dc.sh core/ha-backups* stop*)",
      "Bash(scripts/dc.sh core/ha-backups* restart*)",
      "Edit(./scripts/docker-user-rules.sh)",
      "Edit(./core/ha-backups/smb.conf)",
      "Bash(scripts/dc.sh core/scrutiny* up*)",
      "Bash(scripts/dc.sh core/scrutiny* down*)",
      "Bash(scripts/dc.sh core/scrutiny* stop*)",
      "Bash(scripts/dc.sh core/scrutiny* restart*)",
      "Bash(scripts/dc.sh core/diun* up*)",
      "Bash(scripts/dc.sh core/diun* down*)",
      "Bash(scripts/dc.sh core/diun* stop*)",
      "Bash(scripts/dc.sh core/diun* restart*)",
      "Bash(scripts/dc.sh core/omada* up*)",
      "Bash(scripts/dc.sh core/omada* down*)",
      "Bash(scripts/dc.sh core/omada* stop*)",
      "Bash(scripts/dc.sh core/omada* restart*)",
