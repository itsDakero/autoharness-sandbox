# Copy to .env and fill in. Never commit .env.
# New keys go in their service's section, not at the end of the file.
TZ=Europe/London
PUID=1000
PGID=1000

# Base domain for the bonus Traefik names (http://<service>.lan)
DOMAIN=lan

# Server addresses (LAN IP is reserved in the router)
LAN_IP=192.168.0.210
TAILSCALE_IP=100.78.185.81

# Media library (read-only for most services; never modify contents)
MEDIA_PATH=/mnt/media

# Where service bind-mount data lives (created by bootstrap.sh)
APPDATA_PATH=/srv/homelab

# AdGuard Home admin (set in its first-run wizard; used by core/adguard/apply-rules.sh)
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Uptime Kuma admin (set on first run; used by AutoKuma)
KUMA_USERNAME=
KUMA_PASSWORD=
# Uptime Kuma > Settings > API Keys (used by the dashboard to read /metrics)
KUMA_API_KEY=
# Random part of each cron job's Kuma push token (scripts/cron-run.sh + core/uptime-kuma labels): openssl rand -hex 8 (exactly 16)
KUMA_CRON_PUSH_SECRET=

# NordVPN NordLynx (WireGuard) private key for Gluetun (media/qbittorrent).
# Nord Account > NordVPN > Manual setup > access token, then:
#   curl -s -u token:<TOKEN> https://api.nordvpn.com/v1/users/services/credentials  -> nordlynx_private_key
NORDVPN_WIREGUARD_PRIVATE_KEY=
# Gluetun control server: read-only API key for the dashboard's VPN widget (scripts/gluetun-auth.py).
#   echo "GLUETUN_API_KEY=$(openssl rand -hex 32)" >> .env
GLUETUN_API_KEY=
# qBittorrent Web UI login (scripts/qbit-setup.py seed hashes it into the config; arr apps use it)
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# ntfy topic for watchdog messages (scripts/qbit-watchdog.sh). Same secret topic as Kuma's ntfy-urgent.
NTFY_ALERT_TOPIC=
# Discord feed (non-urgent): channel > Integrations > Webhooks. Secret: anyone with it can post.
# Used by scripts/discord.sh, the dashboard ("idea queued") and scripts/arr-setup.py discord (imports).
DISCORD_WEBHOOK_URL=
# Morning brief (scripts/morning-brief.py, 07:00): 0 = off; unset or anything else = on
MORNING_BRIEF_ENABLED=
# Hermes assistant (M6 stage D): its own Discord bot, in its own channel, answering Dan only.
# Bot token: Developer Portal > your app > Bot > Reset Token. Secret. The IDs: Discord Developer Mode,
# right-click > Copy Channel ID / Copy User ID.
HERMES_DISCORD_BOT_TOKEN=
HERMES_DISCORD_CHANNEL_ID=
HERMES_DISCORD_ALLOWED_USER_ID=
# Login for Prowlarr, Radarr, Sonarr and the remote pair (scripts/arr-setup.py auth)
ARR_USERNAME=
ARR_PASSWORD=
# Jellyfin > Dashboard > API Keys (scripts/jellyfin-setup.py)
JELLYFIN_API_KEY=
# Seerr > Settings > General > API Key (scripts/seerr-setup.py, scripts/seerr-route.py)
SEERR_API_KEY=
# Jellyfin usernames whose Seerr requests go to the remote 720p pair, comma-separated (scripts/seerr-route.py)
SEERR_REMOTE_USERS=
# Dashboard /admin login. Password stored hashed only: run scripts/dashboard-passwd.py and paste its line.
# The session secret signs the 30-day login cookie; changing it (or the password) logs out every device.
#   echo "DASHBOARD_SESSION_SECRET=$(openssl rand -hex 32)" >> .env
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
# SMB password for user "hass" on core/ha-backups (Home Assistant backups). Typed into
# HA > Settings > System > Storage. Letters and digits avoid quoting trouble.
HA_BACKUP_SMB_PASSWORD=
# Garmin Connect login for tools/fitness (account without two-step verification; empty = app shows
# "not configured" and never tries to log in)
GARMIN_EMAIL=
GARMIN_PASSWORD=
# tools/wardrobe: Mac mini Ollama base URL for photo tagging (empty = http://100.74.81.122:11434)
WARDROBE_OLLAMA_URL=
# tools/wardrobe: vision model for tagging (empty = gemma4:12b-it-qat; fallback qwen3.5:9b)
WARDROBE_MODEL=
# tools/fitness: Mac mini Ollama base URL for the weekly summary (empty = http://100.74.81.122:11434)
FITNESS_OLLAMA_URL=
# tools/fitness: text model for the weekly summary (empty = qwen3.5:9b)
FITNESS_MODEL=
# core/dashboard -> Hermes personal feed: changedetection Settings > API key, to list watches changed in 7 days
CHANGEDETECTION_API_KEY=
# tools/fpl + tools/lms: The Odds API key (free tier, 500 credits/month shared, the-odds-api.com); empty = odds pulls skipped
ODDS_API_KEY=
# tools/fpl: your FPL entry id (the number in the FPL "Points" page URL; public, no login). Empty = squad, solve and deadline job say "no FPL_TEAM_ID"
FPL_TEAM_ID=
