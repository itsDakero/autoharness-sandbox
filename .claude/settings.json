      "Bash(curl *downloads/limit*)",
      "Bash(curl * --json*)",
      "Bash(scripts/deploy-idea.sh*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(*dc.sh *.worktrees/* up*)",
      "Bash(*dc.sh *.worktrees/* down*)",
      "Bash(*dc.sh *.worktrees/* stop*)",
      "Bash(*dc.sh *.worktrees/* start*)",
      "Bash(*dc.sh *.worktrees/* restart*)",
      "Bash(*dc.sh *.worktrees/* build*)",
      "Bash(*dc.sh *.worktrees/* run*)",
      "Bash(*dc.sh *.worktrees/* create*)",
      "Bash(*dc.sh *.worktrees/* exec*)",
      "Bash(*dc.sh *.worktrees/* kill*)",
      "Bash(*dc.sh *.worktrees/* rm*)",
      "Bash(*dc.sh *.worktrees/* pull*)",
      "Bash(*.worktrees/*/scripts/dc.sh*)",
      "Read(./.env)",
      "Read(**/*.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|Grep|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compose-check.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/loop-alert.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "autoharness": {
      "source": {
        "source": "github",
        "repo": "tigerless-labs/autoharness"
      }
    }
  },
  "enabledPlugins": {
    "autoharness@autoharness": true
  }
}
