{
  "enabledPlugins": {
    "autoharness@autoharness": true
  },
  "extraKnownMarketplaces": {
    "autoharness": {
      "source": {
        "source": "github",
        "repo": "tigerless-labs/autoharness"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compose-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
